# Direct-access example: browse to http://SERVER_IP:8002 without Nginx.
WS_TERMINAL_HOST=0.0.0.0
WS_TERMINAL_PORT=8002

# Required. Generate with: openssl rand -base64 32
WS_TERMINAL_TOKEN=

WS_TERMINAL_SHELL=/bin/bash
WS_TERMINAL_SHELL_ARGS=-l
WS_TERMINAL_CWD=/root
WS_TERMINAL_TITLE=Server Terminal

WS_TERMINAL_MAX_SESSIONS=8
WS_TERMINAL_MAX_DIRECTORY_ENTRIES=500
WS_TERMINAL_MAX_DIRECTORY_REQUESTS=4
WS_TERMINAL_MAX_FILE_BYTES=1048576
WS_TERMINAL_MAX_FILE_REQUESTS=2
WS_TERMINAL_RECONNECT_GRACE_SECONDS=300
WS_TERMINAL_REPLAY_BYTES=1048576
WS_TERMINAL_MAX_TRANSFER_BYTES=104857600
WS_TERMINAL_MAX_COPY_ENTRIES=10000
WS_TERMINAL_MAX_PREVIEW_BYTES=20971520
WS_TERMINAL_BACKUP_DIR=/var/lib/ws-terminal/backups
WS_TERMINAL_BACKUP_COUNT=10
WS_TERMINAL_BACKUP_MAX_BYTES=268435456
WS_TERMINAL_DRAFT_DIR=/var/lib/ws-terminal/drafts
WS_TERMINAL_DRAFT_TTL_SECONDS=3600
# Enable host mode only in the privileged node-agent deployment.
WS_TERMINAL_HOST_MODE=0
WS_TERMINAL_NODE_NAME=
WS_TERMINAL_NODE_IP=
WS_TERMINAL_IDLE_TIMEOUT_SECONDS=3600
WS_TERMINAL_MAX_SESSION_SECONDS=28800
WS_TERMINAL_LOGIN_TTL_SECONDS=28800
WS_TERMINAL_MAX_LOGIN_SESSIONS=256
WS_TERMINAL_MAX_LOGIN_SESSIONS_PER_ADDRESS=8
WS_TERMINAL_MAX_LOGIN_ATTEMPTS=5
WS_TERMINAL_LOGIN_WINDOW_SECONDS=60
WS_TERMINAL_LOGIN_BLOCK_SECONDS=300
WS_TERMINAL_MAX_TRACKED_LOGIN_ADDRESSES=1024

# Enable only when Node listens behind a trusted local reverse proxy.
WS_TERMINAL_TRUST_PROXY=0
WS_TERMINAL_SECURE_COOKIE=auto
WS_TERMINAL_ALLOWED_ORIGINS=
